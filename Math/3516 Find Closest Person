class Solution {
    public int findClosest(int x, int y, int z) {
        int xdis = Math.abs(x-z);
        int ydis = Math.abs(y-z);

        if(xdis<ydis)
        {
            return 1;
        }
        else if(xdis>ydis)
        {
            return 2;
        }
        else
        {
            return 0;
        }
    }
}
