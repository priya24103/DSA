class Solution {
    public boolean areNumbersAscending(String s) {
        String[] str = s.split(" ");

        int prev = -1;

        for(String st : str)
        {
            if(Character.isDigit(st.charAt(0)))
            {
                int num = Integer.parseInt(st);

                if(num <= prev)
                {
                    return false;
                }

                prev = num;
            }
        }
        return true;
    }
}
